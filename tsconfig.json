{
	"compilerOptions": {
        "strict": true,   /* 启用所有严格类型检查选项 */
		"alwaysStrict": true,
		"isolatedModules": true,
		"module": "commonjs",
		"target": "es6",
		"outDir": "out",
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"lib": [
			"es6"
		],
		"sourceMap": true,
		"strictNullChecks": true,
		"rootDir": "src",
        "noUnusedLocals": true /* 对未使用的局部变量报错 */
	},
	"exclude": [
		"src/test*",
		"node_modules",
		".vscode-test"
	]
}