{
  "name": "better-comments",
  "displayName": "Better Comments",
  "version": "3.0.2",
  "description": "通过告警、说明、TODO 等标签增强代码注释高亮与可读性",
  "categories": [
    "Formatters"
  ],
  "homepage": "https://github.com/aaron-bond/better-comments/blob/master/README.md",
  "bugs": "https://github.com/aaron-bond/better-comments/issues",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Aaron Bond"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aaron-bond/better-comments"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/aaron-bond"
  },
  "publisher": "aaron-bond",
  "main": "./out/extension",
  "browser": "./out/web/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run bundle-desktop && npm run package-web",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle-desktop": "node -e \"require('fs').mkdirSync('out',{recursive:true})\" && esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "lint": "tslint -c tslint.json 'src/**/*.ts'",
    "compile-web": "rspack build --config ./build/web-extension.rspack.config.js",
    "watch-web": "rspack build --watch --config ./build/web-extension.rspack.config.js",
    "package-web": "rspack build --mode production --devtool hidden-source-map --config ./build/web-extension.rspack.config.js",
    "package:vsix": "npm run vscode:prepublish && vsce package --no-dependencies",
    "fmt": "oxfmt"
  },
  "devDependencies": {
    "@rspack/cli": "^1.0.0",
    "@rspack/core": "^1.0.0",
    "@types/node": "^17.0.23",
    "@types/vscode": "^1.65.0",
    "esbuild": "^0.24.2",
    "oxfmt": "^0.40.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "tslint": "^6.1.3",
    "typescript": "^4.6.3",
    "util": "^0.12.4",
    "vsce": "^2.10.0"
  },
  "contributes": {
    "configuration": {
      "title": "Better Comments 配置",
      "properties": {
        "better-comments.multilineComments": {
          "type": "boolean",
          "description": "是否启用多行（块）注释高亮",
          "default": true
        },
        "better-comments.highlightPlainText": {
          "type": "boolean",
          "description": "是否在纯文本文件中启用注释高亮",
          "default": false
        },
        "better-comments.tags": {
          "type": "array",
          "description": "用于注释着色的标签。可为：字符串（逗号分隔）、字符串数组、或对象数组（tag + color 等）。修改后需重启 VS Code 生效",
          "items": {
            "type": "object",
            "title": "tag item",
            "properties": {
              "tag": {
                "type": [
                  "string",
                  "array"
                ],
                "description": "标签名字符串或字符串数组，不区分大小写",
                "items": {
                  "type": "string"
                }
              },
              "color": {
                "type": "string",
                "description": "字体颜色，如：#FF2D00"
              },
              "strikethrough": {
                "type": "boolean",
                "description": "启用文本删除线（ strikethrough）"
              },
              "underline": {
                "type": "boolean",
                "description": "启用文本下划线"
              },
              "backgroundColor": {
                "type": "string",
                "description": "背景颜色，如：transparent（透明）"
              },
              "bold": {
                "type": "boolean",
                "description": "设置文本字体为粗体"
              },
              "italic": {
                "type": "boolean",
                "description": "设置文本字体为斜体"
              },
              "multiline": {
                "type": "boolean",
                "description": "启用多行注释装饰（直到空白行为止）"
              }
            }
          },
          "default": [
            {
              "tag": "#",
              "color": "#18b566",
              "strikethrough": false,
              "underline": false,
              "backgroundColor": "transparent",
              "bold": true,
              "italic": false
            },
            {
              "tag": "!",
              "color": "#FF2D00",
              "strikethrough": false,
              "underline": false,
              "backgroundColor": "transparent",
              "bold": false,
              "italic": false
            },
            {
              "tag": "?",
              "color": "#3498DB",
              "strikethrough": false,
              "underline": false,
              "backgroundColor": "transparent",
              "bold": false,
              "italic": false
            },
            {
              "tag": "//",
              "color": "#474747",
              "strikethrough": true,
              "underline": false,
              "backgroundColor": "transparent",
              "bold": false,
              "italic": false
            },
            {
              "tag": "todo",
              "color": "#FF8C00",
              "strikethrough": false,
              "underline": false,
              "backgroundColor": "transparent",
              "bold": false,
              "italic": false,
              "multiline": true
            },
            {
              "tag": "bug",
              "color": "#E84393",
              "strikethrough": false,
              "underline": true,
              "backgroundColor": "#FDA7DF20",
              "bold": true,
              "italic": false
            },
            {
              "tag": "feat",
              "color": "#9B59B6",
              "strikethrough": false,
              "underline": false,
              "backgroundColor": "#9B59B620",
              "bold": true,
              "italic": true
            },
            {
              "tag": "fix",
              "color": "#FD79A8",
              "strikethrough": false,
              "underline": false,
              "backgroundColor": "#FD79A820",
              "bold": true,
              "italic": false
            }
          ]
        },
        "better-comments.output.minLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "debug",
          "description": "输出面板最低日志级别，低于此级别的日志不显示"
        },
        "better-comments.output.filterKeyword": {
          "type": "string",
          "default": "",
          "description": "输出面板关键词筛选，仅显示包含该关键词的日志（留空则不过滤）"
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#e3f4ff",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.74.0"
  }
}
